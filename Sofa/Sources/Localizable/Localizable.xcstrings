    "deleteGenerationMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation removal will be instant, deleting all internal plans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de la génération est immédiate et efface tous les plans internes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de la génération est immédiate et efface tous les plans internes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen der Generation erfolgt sofort und entfernt alle internen Pläne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जनरेशन तुरंत हटाई जाएगी, सभी आंतरिक प्लान हट जाएंगे."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan generasi berlangsung seketika dan menghapus semua rencana internal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rimozione della generazione è immediata e cancella tutti i piani interni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成は即座に削除され、内部のプランもすべて消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성이 즉시 삭제되며 내부 플랜이 모두 지워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A remoção da geração é instantânea e apaga todos os planos internos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A remoção da geração é imediata e apaga todos os planos internos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление генерации произойдет мгновенно, все внутренние планы будут удалены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación de la generación será inmediata y borrará todos los planes internos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación de la generación será inmediata y borrará todos los planes internos."
          }
        },

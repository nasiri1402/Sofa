    "pleaseRateUsDescription": {
      "comment": "A description displayed below the main text in the \"Please Rate Us\" view, explaining why rating the app is appreciated.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {

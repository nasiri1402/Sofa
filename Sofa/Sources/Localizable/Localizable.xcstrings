    "answerQuestionsAboutYourGoalAndGetAnActionPlan": {
      "comment": "Title of a section in the onboarding flow that asks users to answer questions about their goals and get an action plan.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer questions about your goal and get an action plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à des questions sur votre objectif et obtenez un plan d’action."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à des questions sur votre objectif et obtenez un plan d’action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte Fragen zu deinem Ziel und erhalte einen Aktionsplan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लक्ष्य के बारे में प्रश्नों के उत्तर दें और एक कार्य योजना पाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab pertanyaan tentang tujuanmu dan dapatkan rencana aksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi alle domande sul tuo obiettivo e ottieni un piano d’azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標についての質問に答えて、行動計画を受け取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표에 대한 질문에 답하고 실행 계획을 받아보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda às perguntas sobre sua meta e receba um plano de ação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde às perguntas sobre o teu objetivo e recebe um plano de ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответьте на вопросы о цели и получите план действий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde preguntas sobre tu objetivo y obtén un plan de acción."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde preguntas sobre tu objetivo y obtén un plan de acción."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinle ilgili soruları yanıtla ve bir eylem planı al."
          }
        }

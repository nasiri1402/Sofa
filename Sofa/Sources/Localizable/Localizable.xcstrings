    "notificationDisableMessage" : {
      "comment" : "Message displayed in an alert when the user confirms disabling notifications.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Benachrichtigungsberechtigungen in den Einstellungen verwalten. Wenn Sie sie deaktivieren, können wir Sie nicht über wichtige Ereignisse informieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can manage notification permissions in Settings. If you turn them off, we won’t be able to notify you about important events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes gestionar los permisos de notificaciones en Configuración. Si los desactivas, no podremos notificarte sobre eventos importantes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes administrar los permisos de notificaciones en Configuración. Si los desactivas, no podremos notificarte sobre eventos importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez gérer les autorisations de notifications dans les Réglages. Si vous les désactivez, nous ne pourrons pas vous avertir des événements importants."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez gérer les autorisations de notifications dans les Réglages. Si vous les désactivez, nous ne pourrons pas vous avertir des événements importants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप सेटिंग्स में नोटिफिकेशन अनुमतियाँ प्रबंधित कर सकते हैं। यदि आप उन्हें बंद करते हैं, तो हम आपको महत्वपूर्ण घटनाओं के बारे में सूचित नहीं कर पाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat mengelola izin notifikasi di Pengaturan. Jika Anda mematikannya, kami tidak akan dapat memberi tahu Anda tentang peristiwa penting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi gestire i permessi di notifica nelle Impostazioni. Se li disattivi, non potremo avvisarti di eventi importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知の許可は設定で管理できます。オフにすると、重要なイベントについて通知できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 알림 권한을 관리할 수 있습니다. 알림을 끄면 중요한 이벤트에 대해 알릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode gerenciar as permissões de notificação nas Configurações. Se você desativá-las, não poderemos notificar você sobre eventos importantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {

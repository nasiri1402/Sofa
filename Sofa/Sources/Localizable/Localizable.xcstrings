        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रेटिंग हमारे लिए महत्वपूर्ण है और\nऐप को बेहतर बनाने में मदद करेगी!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
